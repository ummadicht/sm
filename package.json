  },
  "scripts": {
    "dev": "([ -f dist-web/store/index.html ] && [ -f dist-web/check/index.html ] || bash scripts/export-web.sh all --fast) && node scripts/web-dev-proxy.mjs",
    "build": "bash scripts/export-web.sh all --fast",
    "start": "node scripts/web-dev-proxy.mjs",
    "lint": "tsc --noEmit",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "start:store": "APP_VARIANT=store expo start",
    "start:check": "APP_VARIANT=check expo start",
    "typecheck": "tsc --noEmit"
  },
  "private": true
